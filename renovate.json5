{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  internalChecksFilter: "strict",
  automergeType: "pr",
  // No branch protections: Renovate must see passing CI before performing the merge.
  platformAutomerge: false,
  // Disabled charts may retain data that needs migration before a future upgrade.
  ignorePaths: ["**/*.disabled/**"],
  packageRules: [
    {
      description: "Track runner image releases while preserving Ubuntu and slim/full variants",
      matchDatasources: ["docker"],
      matchPackageNames: ["gitea/runner-images"],
      versioning: "regex:^(?<compatibility>ubuntu-\\d+\\.\\d+-(?:slim|full))-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      groupName: "Docker images",
      groupSlug: "dockerimages",
      matchDatasources: ["docker"],
      pinDigests: true,
    },
    {
      description: "Merge container image minor and patch updates after CI passes",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "Docker images (minor and patch)",
      groupSlug: "dockerimages-minor-patch",
      automerge: true,
    },
  ],
  customManagers: [
    {
      // Forgejo runner labels embed job images rather than Kubernetes image fields.
      // Keep the label names and image streams intact while tracking tags and digests.
      customType: "regex",
      managerFilePatterns: ["/^apps/charts/forgejo/values\\.yaml$/"],
      matchStrings: [
        "docker://(?<depName>[^\\s\"@]+):(?<currentValue>[^\\s\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?",
      ],
      // Pinning starts with no currentDigest, so Renovate must build the full reference.
      autoReplaceStringTemplate:
        "docker://{{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}",
      datasourceTemplate: "docker",
      versioningTemplate: "docker",
    },
  ],
}
